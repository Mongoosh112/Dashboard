# ========================================================
# QuantumPropAI Environment Configuration
# ========================================================

# Server Port (defaults to 5000)
PORT=5000

# MongoDB Atlas Connection String
# Get your free forever cluster at: https://www.mongodb.com/atlas
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/QuantumPropAI?retryWrites=true&w=majority
MONGODB_URI=

# Secret key for signing JSON Web Tokens (min 32 characters recommended)
# If empty, a secure secret is auto-generated and stored in server/data/.jwt_secret
JWT_SECRET=

# Admin account bootstrap password (min 8 chars). Used only when the admin account is first created.
ADMIN_PASSWORD=

# Urgent Directive Auto-Deletion Lifespan in milliseconds (default: 3600000 ms = 1 hour)
URGENT_DIRECTIVE_LIFETIME_MS=3600000
